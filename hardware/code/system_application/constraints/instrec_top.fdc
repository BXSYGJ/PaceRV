### Top-level constraints for InstRec-FPGA (instrec_top), full M0 version
### (T-M0-09 integration). Pin map per design doc section 2.2.1:
###   board  : clk D18 / rst_n C22 / key1_n C23 / led A20..B17 / uart B24 C24
###   I2S    : i2s_bck U20 / i2s_lrck T20 / i2s_sd V16
###   HDMI   : vout_* + iic_* copied pin-by-pin from the 100Pro+ demo fdc
###            (ad9280_ad9708_HDMI.fdc, DRIVE 4 / FAST)
###   DDR3   : ref_clk_p/n N3/N2 + 73 mem pins stay in ddr3_100h.fdc
### The primary clock name is "clk" so the set_clock_groups line of the
### copied ddr3_100h.fdc (get_clocks {clk}) resolves unchanged.

create_clock -name {clk} [get_ports {clk}] -period {37.037} -waveform {0.000 18.519}

# ---- derived clocks from the video GPLL (148.5 MHz pixel,
# ---- HDMI I2C config 10.395 MHz) ----
create_generated_clock -name {pix_clk} -source [get_ports {clk}] [get_pins {u_hdmi_tx_if/u_pll/u_gpll/CLKOUT0}] -multiply_by {11} -divide_by {2}
# cfg_clk: explicit name for the demo GPLL clkout1 (10.395 MHz = 27 x 77/200).
# The explicit declaration supersedes the hierarchical "Inferred" clock so
# the asynchronous groups can reference it by a clean name.
create_generated_clock -name {cfg_clk} -source [get_ports {clk}] [get_pins {u_hdmi_tx_if/u_pll/u_gpll/CLKOUT1}] -multiply_by {77} -divide_by {200}

# ---- clock domain asynchronicity (design doc section 1.4 CDC table) ----
# Board audio processing and pixel clock cross through CDC logic. The groups
# that reference the DDR3 family clocks (created later by ddr3_100h.fdc)
# live in constraints/clock_groups_async.fdc, which is loaded AFTER
# ddr3_100h.fdc so every get_clocks reference resolves (SDC-2027 lesson:
# a group naming a not-yet-created clock makes PDS ignore the command).
set_clock_groups -asynchronous -group [get_clocks {clk}] -group [get_clocks {pix_clk}]


define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}

